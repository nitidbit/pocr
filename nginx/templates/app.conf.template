upstream app {
    server app:8080;
    keepalive 32;
}

upstream vouch {
    server vouch:9090;
    keepalive 32;
}

upstream api_backend {
    server engine:3000;
    keepalive 32;
}

server {
    listen ${NGINX_SERVER_PORT} ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/ssl.pem;
    ssl_certificate_key /etc/nginx/certs/ssl.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # Vouch public endpoints
    location ~ ^/(auth|login|logout|static) {
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_set_header Host $host;
        proxy_pass http://vouch;
    }

    # Vouch validate endpoint
    location = /validate {
        internal;
        include /etc/nginx/snippets/vouch-validate.conf;
    }

    error_page 401 = @error401;

    location @error401 {
        return 302 $scheme://$host/login?url=$scheme://$host$request_uri&vouch-failcount=$auth_resp_failcount&X-Vouch-Token=$auth_resp_jwt&error=$auth_resp_err;
    }

    # XHR-safe 401 for browser API calls — plain status, no HTML login redirect
    location @api_unauthorized {
        return 401;
    }

    # Browser identity endpoint — authenticated so the frontend header
    # (name/email/avatar) resolves from Vouch. Exact match wins over /api/.
    location = /api/me {
        auth_request /validate;

        # An unauthenticated XHR must get a 401, not a 302 to the login page.
        error_page 401 = @api_unauthorized;

        include /etc/nginx/snippets/vouch-proxy-headers.conf;
        include /etc/nginx/snippets/proxy-common.conf;

        proxy_pass http://api_backend;
    }

    # API routes — unauthenticated; vouch cookie is forwarded to backend
    location /api/ {
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://api_backend;
    }

    location /cds-services {
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://api_backend;
    }

    # Browser app routes protected by Vouch
    location / {
        auth_request /validate;
        auth_request_set $auth_resp_jwt       $upstream_http_x_vouch_jwt;
        auth_request_set $auth_resp_err       $upstream_http_x_vouch_err;
        auth_request_set $auth_resp_failcount $upstream_http_x_vouch_failcount;

        include /etc/nginx/snippets/vouch-proxy-headers.conf;
        include /etc/nginx/snippets/proxy-common.conf;

        proxy_pass http://app;
    }
}

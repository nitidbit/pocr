{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "POCR dataset definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "title",
    "source",
    "stored_procedure",
    "fields"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "maxLength": 128
    },
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "description": {
      "type": "string"
    },
    "source": {
      "const": "caboodle"
    },
    "stored_procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "name"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "maxLength": 128
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "column"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "maxLength": 128,
            "not": {
              "enum": [
                "randomization_id",
                "arm_id",
                "arm_name"
              ]
            }
          },
          "type": {
            "enum": [
              "string",
              "number",
              "boolean"
            ]
          },
          "column": {
            "type": "string",
            "pattern": "\\S",
            "not": {
              "const": "randomization_id"
            }
          }
        }
      }
    }
  }
}

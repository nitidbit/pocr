# POCR site configuration. pocr-init copies this to .env and fills in the
# generated values; edit the rest, then `docker compose up -d`.
# .env holds secrets: keep it mode 600 and out of version control.

# --- Release ------------------------------------------------------------------
# Image location and version. To upgrade, change POCR_VERSION, then
# `docker compose pull && docker compose up -d` (back up first).
POCR_IMAGE_REPO=ghcr.io/OWNER
POCR_VERSION=VERSION

# --- Server -------------------------------------------------------------------
# DNS name users and Epic use to reach POCR. certs/ssl.pem must be valid for it.
POCR_HOST=pocr.example.org

# Which EHR environments may randomize, and whether each is production or
# nonproduction: `fhirServer-prefix=environment` pairs separated by `;`.
# Ask your Interconnect admin for each Epic environment's FHIR base URL.
FHIR_ENV_MAP=https://epic-prd.example.org/interconnect-prd/api/FHIR/R4=production;https://epic-tst.example.org/interconnect-tst/api/FHIR/R4=nonproduction

# Who may call /cds-services, which has no login: your Epic Interconnect
# servers' addresses or CIDR ranges, separated by spaces or commas.
# Empty refuses everyone. `all` is for demo servers with synthetic data only.
CDS_ALLOW_FROM=

# --- Console login (Vouch + your identity provider) ---------------------------
# Who may log in to the console. Any of them can change any study
# (docs/security-concerns.md S1), so list named people.
POCR_ALLOWED_USERS=pi@example.org,coordinator@example.org
# Alternative, less strict: leave POCR_ALLOWED_USERS empty and admit everyone
# whose email is in these domains.
# POCR_ALLOWED_EMAIL_DOMAINS=example.org

# Register an application with your identity provider, with redirect URI
# https://<POCR_HOST>/auth, and copy its values here.
# Any OIDC provider (Okta, Entra ID, Ping, Keycloak, ...):
OAUTH_PROVIDER=oidc
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTH_URL=https://idp.example.org/oauth2/v1/authorize
OAUTH_TOKEN_URL=https://idp.example.org/oauth2/v1/token
OAUTH_USER_INFO_URL=https://idp.example.org/oauth2/v1/userinfo
# For Google instead: OAUTH_PROVIDER=google and delete the three URLs.

# Generated by pocr-init. Changing them logs everyone out.
VOUCH_JWT_SECRET=
VOUCH_SESSION_KEY=

# --- Demo servers only --------------------------------------------------------
# For a server used with the public CDS Hooks sandbox (synthetic data, no Epic
# connection). Leave unset on a real install. See docs/install.md.
# CDS_CORS_ORIGINS=https://sandbox.cds-hooks.org
# CDS_DISCOVERY_LIST_STUDIES=true
